# Copy to .env and fill in. Start with:  node --env-file=.env src/server.js
# Never commit .env.

# Port the app listens on. Caddy / nginx in front forwards https://your-domain to it.
PORT=3000
# 127.0.0.1 = only reachable through the reverse proxy (recommended). Use 0.0.0.0 inside Docker.
HOST=127.0.0.1

# One-time token for the /setup page (creating the first admin). At least 16 characters.
# Make one with:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# After the first admin exists the setup page is closed for good; you can then remove this line.
SETUP_TOKEN=

# Where the database lives (users, sessions, activity log — no patient data). Back this folder up.
DATA_DIR=./data

# Key that encrypts two-step secrets in the database (32 bytes, base64).
# Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If empty, a key file is created in DATA_DIR on first start.
SECRET_KEY=

# 1 when Caddy / nginx is in front (real client IPs for rate limits and the activity log).
TRUST_PROXY=1

# Only for trying it on your own computer over plain http (no https). Never in production.
# INSECURE_HTTP=1
